{
  "name": "homa",
  "version": "1.0.0",
  "main": "dist-electron/electron/main.js",
  "description": "نرم‌افزار دسکتاپ رایگان و متن‌باز مدیریت آموزشگاه: مشتریان، جلسات، حضور RFID و صندوق",
  "author": "Mohammad Fazeli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammad-fazeli/homa.git"
  },
  "homepage": "https://github.com/mohammad-fazeli/homa#readme",
  "bugs": {
    "url": "https://github.com/mohammad-fazeli/homa/issues"
  },
  "keywords": [
    "electron",
    "react",
    "academy",
    "education",
    "rfid",
    "attendance",
    "persian",
    "rtl",
    "sqlite",
    "desktop-app"
  ],
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run electron:start",
    "electron:start": "tsc -p electron && electron dist-electron/electron/main.js",
    "build:renderer": "cd renderer && vite build",
    "build:electron": "tsc -p electron",
    "build": "npm run build:renderer && npm run build:electron",
    "icon": "powershell -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "predist": "npm run icon",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "lint": "tsc -p electron --noEmit && tsc -p renderer --noEmit && eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.8",
    "@tailwindcss/postcss": "^4.1.17",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.11.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.5.1",
    "serialport": "^13.0.0",
    "tailwindcss": "^4.1.17",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.17.0",
    "postcss": "^8.5.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.1",
    "vitest": "^2.1.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.homa.studentmanager",
    "productName": "هما",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "renderer/dist/**/*",
      "data/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "executableName": "Homa",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "هما",
      "uninstallDisplayName": "هما",
      "artifactName": "Homa-Setup-${version}.${ext}"
    }
  }
}
